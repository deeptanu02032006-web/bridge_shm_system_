# MongoDB Atlas Connection URI (Primary Database)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=shm_bridge_db

# Query API Configuration (Read-Only MongoDB Layer)
BIND_HOST=0.0.0.0
PORT=5000
QUERY_API_KEY=<generate-a-secure-read-only-api-key>

# Hardware & Serial Port Configuration (Arduino UNO-01)
ARDUINO_ID=UNO-01
SERIAL_PORT=COM6
BAUD_RATE=115200

# Google Apps Script Web App URL (Secondary Rolling Cache Sync)
WEB_APP_URL=<google-apps-script-web-app-url>

# AI Chatbot Configuration (Provider-Independent MongoDB Telemetry Assistant)
# Options for AI_PROVIDER: auto, openai, gemini, none
AI_PROVIDER=none

# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=<current-supported-openai-model>

# GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=<current-supported-gemini-model>
